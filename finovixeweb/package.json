{
  "name": "finovixe",
  "version": "1.0.0",
  "description": "Sistema de Ventas e Inventario Finovixe",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "start": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^5.2.1",
    "node-machine-id": "^1.1.12",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11"
  },
  "build": {
    "extends": "./electron-builder.config.js",
    "appId": "com.inovixe.finovixe",
    "productName": "Finovixe",
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icono.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
